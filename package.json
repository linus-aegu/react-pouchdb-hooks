{
  "name": "@aegu/react-pouchdb-hooks",
  "version": "1.5.1",
  "description": "React Hooks for PouchDB",
  "main": "lib/node/index.js",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "browser": "lib/index.js",
  "module": "lib/index.js",
  "jsnext:main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc && tsc --project node-tsconfig.json",
    "format": "prettier --write .",
    "prepublish": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test-ci": "jest --ci",
    "lint": "eslint ./src --ext .js,.jsx,.ts,.tsx",
    "textlint": "textlint README.md docs/*"
  },
  "keywords": [
    "react",
    "hooks",
    "react-hooks",
    "typescript",
    "pouchdb",
    "couchdb"
  ],
  "author": {
    "name": "Linus Gubenis",
    "email": "linus@aegu.de",
    "url": "https://aegu.de/"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/linus-aegu/react-pouchdb-hooks.git"
  },
  "homepage": "https://linus-aegu.github.io/react-pouchdb-hooks/",
  "files": [
    "README.md",
    "lib"
  ],
  "devDependencies": {
    "@babel/core": "^7.12.3",
    "@babel/preset-env": "^7.12.1",
    "@babel/preset-react": "^7.12.1",
    "@babel/preset-typescript": "^7.12.1",
    "@testing-library/react": "^16.3.0",
    "@tsconfig/node12": "^1.0.9",
    "@types/jest": "^26.0.24",
    "@types/node": "^14.18.42",
    "@types/pouchdb-adapter-memory": "^6.1.6",
    "@typescript-eslint/eslint-plugin": "^4.6.0",
    "@typescript-eslint/parser": "^4.6.0",
    "babel-jest": "^29.7.0",
    "eslint": "^7.12.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-jest": "^24.1.0",
    "eslint-plugin-react": "^7.21.5",
    "eslint-plugin-react-hooks": "^4.2.0",
    "husky": "^4.3.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "pouchdb-adapter-memory": "^9.0.0",
    "pouchdb-find": "^9.0.0",
    "pouchdb-mapreduce": "^9.0.0",
    "pouchdb-selector-core": "^9.0.0",
    "prettier": "^3.6.2",
    "pretty-quick": "^4.2.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-test-renderer": "^19.1.1",
    "semantic-release": "^21.0.1",
    "textlint": "^12.0.2",
    "textlint-rule-alex": "^5.0.0",
    "textlint-rule-common-misspellings": "^1.0.1",
    "typescript": "^4.0.5"
  },
  "dependencies": {
    "@types/pouchdb-core": "^7.0.15",
    "@types/pouchdb-find": "^7.3.3",
    "@types/pouchdb-mapreduce": "^6.1.10",
    "@types/react": "^18.0.14",
    "fast-deep-equal": "^3.1.3",
    "pouchdb-core": "^8.0.1 || ^9",
    "pouchdb-errors": "^8.0.1 || ^9",
    "pouchdb-utils": "^8.0.1 || ^9"
  },
  "peerDependencies": {
    "react": ">=16.8"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "release": {
    "branches": [
      "latest"
    ]
  },
  "prettier": {
    "arrowParens": "avoid",
    "semi": false,
    "singleQuote": true
  }
}
